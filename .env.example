# CONVERGENCE server configuration. Copy to .env and edit.
# Never commit .env or private keys.

PORT=8787
HOST=127.0.0.1
DB_PATH=data/convergence.db
SESSION_TTL_HOURS=168
# Set true when serving over HTTPS (recommended in production)
COOKIE_SECURE=false

# auto: use live Polymarket when reachable, otherwise the demo catalog
# live: require live Polymarket data, fail loudly if unavailable
# demo: never call Polymarket; still uses live Hyperliquid prices
MARKET_DATA_MODE=auto

# paper: orders fill against a deterministic paper broker (default, safe)
# live:  send real orders; requires credentials below AND LIVE_TRADING_ACK
TRADING_MODE=paper
LIVE_TRADING_ACK=

# ---------------- Hyperliquid public data ----------------
HL_API_URL=https://api.hyperliquid.xyz
HL_ENABLED=true

# ---------------- Hyperliquid live trading ----------------
# The private key is read from the environment only, never stored in the DB.
HL_PRIVATE_KEY=
HL_WALLET_ADDRESS=
HL_TESTNET=false

# ---------------- Polymarket public data ----------------
PM_GAMMA_URL=https://gamma-api.polymarket.com
PM_CLOB_URL=https://clob.polymarket.com
PM_ENABLED=true

# ---------------- Polymarket live trading ----------------
PM_PRIVATE_KEY=
PM_FUNDER_ADDRESS=
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=
PM_SIGNATURE_TYPE=1
PM_CHAIN_ID=137
PM_RPC_URL=https://polygon-rpc.com

# Optional: send alerts to a webhook on kill switch / review escalation
ALERT_WEBHOOK_URL=
