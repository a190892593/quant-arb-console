{
  "name": "convergence-terminal",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "CONVERGENCE · Polymarket × Hyperliquid cross-venue event arbitrage terminal",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/domain.test.mjs tests/accounts.test.mjs tests/risk.test.mjs tests/api.test.mjs",
    "verify": "npm run build && node tools/verify.mjs",
    "doctor": "node tools/doctor.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@nktkas/hyperliquid": "^0.33.3",
    "@polymarket/clob-client": "^5.8.1",
    "fastify": "^5.6.0",
    "pino": "^9.5.0",
    "viem": "^2.46.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
